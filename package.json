{
  "name": "dsh-while",
  "version": "0.1.0-preview.2",
  "description": "while — a global DSH assistant with chat, goals, ideas and Session coordination.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./resident": "./lib/resident.js"
  },
  "files": [
    "lib",
    "agent/AGENTS.md",
    "cordis.patch.yml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "media"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-approval",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-tool-web": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "esbuild": "0.25.12",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-tool-web": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.2",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.2"
  },
  "scripts": {
    "check": "node scripts/check-release.mjs",
    "test": "node --test test/*.test.mjs",
    "build:session-surface": "node scripts/build-session-surface.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "assistant",
    "goals",
    "ideas"
  ],
  "engines": {
    "node": ">=22"
  }
}
